#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION TRIALS_VERSION_COMMAS
PRODUCTVERSION TRIALS_VERSION_COMMAS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904B0"
    BEGIN
      VALUE "CompanyName", "TekRant Gaming"
      VALUE "FileDescription", "Trials The Recompilation Collection"
      VALUE "FileVersion", TRIALS_VERSION
      VALUE "ProductName", "Trials The Recompilation Collection"
      VALUE "ProductVersion", TRIALS_VERSION
      VALUE "OriginalFilename", "trials_launcher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1200
  END
END

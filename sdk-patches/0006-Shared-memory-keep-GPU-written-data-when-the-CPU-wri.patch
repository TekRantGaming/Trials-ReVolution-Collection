   memory::Memory& memory_;
@@ -176,6 +180,17 @@ class SharedMemory {
   std::vector<uint64_t> system_page_flags_valid_and_gpu_written_;
   uint32_t num_system_page_flags_ = 0;
 
+  // GPU-written pages the CPU has since written to, as they were in guest memory before the first CPU write. Guest
+  // memory lacks the GPU's data (memory export is not read back), so uploading such a page whole would replace the
+  // GPU's data with stale bytes; only the bytes the CPU changed are uploaded instead.
+  static constexpr size_t kMaxGpuPageSnapshots = 4096;
+  std::unordered_map<uint32_t, std::unique_ptr<uint8_t[]>> gpu_page_snapshots_;
+  // Snapshots taken out for the current upload (only used by RequestRanges).
+  std::vector<std::pair<uint32_t, std::unique_ptr<uint8_t[]>>> snapshot_uploads_;
+  std::vector<std::pair<uint32_t, uint32_t>> upload_ranges_kept_;
+  std::vector<std::pair<uint32_t, uint32_t>> upload_byte_ranges_;
+  bool UploadCpuChangedBytes();
+
   static std::pair<uint32_t, uint32_t> MemoryInvalidationCallbackThunk(
       void* context_ptr, uint32_t physical_address_start, uint32_t length, bool exact_range);
 

diff --git a/src/graphics/d3d12/shared_memory.cpp b/src/graphics/d3d12/shared_memory.cpp
index a5c97a0..cce30f4 100644
--- a/src/graphics/d3d12/shared_memory.cpp
+++ b/src/graphics/d3d12/shared_memory.cpp
@@ -338,4 +338,30 @@ bool D3D12SharedMemory::UploadRanges(
   return true;
 }
 
+bool D3D12SharedMemory::UploadByteRanges(
+    const std::vector<std::pair<uint32_t, uint32_t>>& upload_byte_ranges) {
+  if (upload_byte_ranges.empty()) {
+    return true;
+  }
+  CommitUAVWritesAndTransitionBuffer(D3D12_RESOURCE_STATE_COPY_DEST);
+  command_processor_.SubmitBarriers();
+  auto& command_list = command_processor_.GetDeferredCommandList();
+  for (auto upload_range : upload_byte_ranges) {
+    ID3D12Resource* upload_buffer;
+    size_t upload_buffer_offset;
+    uint8_t* upload_buffer_mapping =
+        upload_buffer_pool_->Request(command_processor_.GetCurrentSubmission(), upload_range.second,
+                                     4, &upload_buffer, &upload_buffer_offset, nullptr);
+    if (upload_buffer_mapping == nullptr) {
+      REXGPU_ERROR("Shared memory: Failed to get an upload buffer");
+      return false;
+    }
+    std::memcpy(upload_buffer_mapping, memory().TranslatePhysical(upload_range.first),
+                upload_range.second);
+    command_list.D3DCopyBufferRegion(buffer_, upload_range.first, upload_buffer,
+                                     UINT64(upload_buffer_offset), UINT64(upload_range.second));
+  }
+  return true;
+}
+
 }  // namespace rex::graphics::d3d12

@@ -554,6 +554,14 @@ class SpirvShaderTranslator : public ShaderTranslator {
     assert_true(is_pixel_shader());
     return IsWritingFloat24Depth() && !current_shader().writes_depth();
   }
+  // Whether every host pixel of a guest pixel takes the first one's interpolants
+  // (ps_guest_pixel_center_shaders).
+  bool IsInterpolatedAtGuestPixelCenter() const {
+    return is_pixel_shader() && !is_depth_only_fragment_shader_ &&
+           (draw_resolution_scale_x_ > 1 || draw_resolution_scale_y_ > 1) &&
+           !current_shader().memexport_eM_written() &&
+           IsPixelShaderAtGuestPixelCenter(current_shader().ucode_data_hash());
+  }
 
   uint32_t GetModificationInterpolatorMask() const {
     Modification modification = GetSpirvShaderModification();

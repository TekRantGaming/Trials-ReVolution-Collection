From d20a3ff56aa5a114c4f9cb19a3776e25ddfbb4a7 Mon Sep 17 00:00:00 2001
From: TekRantGaming <craigferels896@gmail.com>
Date: Mon, 26 Oct 2026 13:51:04 +0000
Subject: [PATCH 1/2] D3D12: texture fetches with the integer number format
 return the stored integers

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../pipeline/shader/dxbc_translator_fetch.cpp | 83 +++++++++++++++++++
 1 file changed, 83 insertions(+)

diff --git a/src/graphics/pipeline/shader/dxbc_translator_fetch.cpp b/src/graphics/pipeline/shader/dxbc_translator_fetch.cpp
index 31de175..8fb2e32 100644
--- a/src/graphics/pipeline/shader/dxbc_translator_fetch.cpp
+++ b/src/graphics/pipeline/shader/dxbc_translator_fetch.cpp
@@ -1951,6 +1951,89 @@ void DxbcShaderTranslator::ProcessTextureFetchInstruction(
     PopSystemTemp();
   }
 
+  if (instr.opcode == FetchOpcode::kTextureFetch && used_result_nonzero_components) {
+    // Integer number format (fetch constant dword 3 bit 0) on a fixed-point format: the guest shader gets the stored
+    // integers, not values normalized to 0...1. The host view is UNORM, so scale each channel back by its maximum
+    // and round (exact for point sampling). The result is already swizzled by the host view, so each component's
+    // multiplier is picked through the fetch constant's swizzle. Trials Evolution and Trials Fusion build their
+    // virtual textures this way: raw DXT block bits in k_16_16_16_16, a k_16 table of tiled block offsets, and a
+    // k_1_5_5_5 indirection texture holding page coordinates and a mip exponent.
+    uint32_t nf_temp = PushSystemTemp();     // x: flag, then compares; y: format, then sign; z: swizzle; w: multiplier
+    uint32_t mult_temp = PushSystemTemp();   // per source channel maximum
+    uint32_t round_temp = PushSystemTemp();  // x: rounded component; y: signed multiplier
+    uint32_t signs_raw_temp = PushSystemTemp();  // per source channel sign (fetch constant dword 0)
+    a_.OpAnd(dxbc::Dest::R(nf_temp, 0b0001), RequestTextureFetchConstantWord(tfetch_index, 3), dxbc::Src::LU(1));
+    a_.OpIf(true, dxbc::Src::R(nf_temp, dxbc::Src::kXXXX));
+    a_.OpAnd(dxbc::Dest::R(nf_temp, 0b0010), RequestTextureFetchConstantWord(tfetch_index, 1), dxbc::Src::LU(63));
+    a_.OpMov(dxbc::Dest::R(mult_temp), dxbc::Src::LF(1.0f));
+    a_.OpSwitch(dxbc::Src::R(nf_temp, dxbc::Src::kYYYY));
+    for (xenos::TextureFormat format :
+         {xenos::TextureFormat::k_8, xenos::TextureFormat::k_8_A, xenos::TextureFormat::k_8_B,
+          xenos::TextureFormat::k_8_8, xenos::TextureFormat::k_8_8_8_8, xenos::TextureFormat::k_8_8_8_8_A}) {
+      a_.OpCase(dxbc::Src::LU(uint32_t(format)));
+    }
+    a_.OpMov(dxbc::Dest::R(mult_temp), dxbc::Src::LF(255.0f));
+    a_.OpBreak();
+    for (xenos::TextureFormat format :
+         {xenos::TextureFormat::k_16, xenos::TextureFormat::k_16_16, xenos::TextureFormat::k_16_16_16_16}) {
+      a_.OpCase(dxbc::Src::LU(uint32_t(format)));
+    }
+    a_.OpMov(dxbc::Dest::R(mult_temp), dxbc::Src::LF(65535.0f));
+    a_.OpBreak();
+    a_.OpCase(dxbc::Src::LU(uint32_t(xenos::TextureFormat::k_1_5_5_5)));
+    a_.OpMov(dxbc::Dest::R(mult_temp), dxbc::Src::LF(31.0f, 31.0f, 31.0f, 1.0f));
+    a_.OpBreak();
+    a_.OpCase(dxbc::Src::LU(uint32_t(xenos::TextureFormat::k_5_6_5)));
+    a_.OpMov(dxbc::Dest::R(mult_temp), dxbc::Src::LF(31.0f, 63.0f, 31.0f, 1.0f));
+    a_.OpBreak();
+    a_.OpCase(dxbc::Src::LU(uint32_t(xenos::TextureFormat::k_4_4_4_4)));
+    a_.OpMov(dxbc::Dest::R(mult_temp), dxbc::Src::LF(15.0f));
+    a_.OpBreak();
+    a_.OpCase(dxbc::Src::LU(uint32_t(xenos::TextureFormat::k_2_10_10_10)));
+    a_.OpMov(dxbc::Dest::R(mult_temp), dxbc::Src::LF(1023.0f, 1023.0f, 1023.0f, 3.0f));
+    a_.OpBreak();
+    a_.OpEndSwitch();
+    // Signs of the source channels: X at bit 2, Y at 4, Z at 6, W at 8 of dword 0.
+    a_.OpUBFE(dxbc::Dest::R(signs_raw_temp), dxbc::Src::LU(2), dxbc::Src::LU(2, 4, 6, 8),
+              RequestTextureFetchConstantWord(tfetch_index, 0));
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (!(used_result_nonzero_components & (1 << i))) {
+        continue;
+      }
+      // Source channel of this component (0...3 are X...W, others are constants: no change).
+      a_.OpUBFE(dxbc::Dest::R(nf_temp, 0b0100), dxbc::Src::LU(3), dxbc::Src::LU(1 + 3 * i),
+                RequestTextureFetchConstantWord(tfetch_index, 3));
+      a_.OpMov(dxbc::Dest::R(nf_temp, 0b1000), dxbc::Src::LF(1.0f));
+      a_.OpMov(dxbc::Dest::R(nf_temp, 0b0010), dxbc::Src::LU(0));
+      for (uint32_t c = 0; c < 4; ++c) {
+        a_.OpIEq(dxbc::Dest::R(nf_temp, 0b0001), dxbc::Src::R(nf_temp, dxbc::Src::kZZZZ), dxbc::Src::LU(c));
+        a_.OpMovC(dxbc::Dest::R(nf_temp, 0b1000), dxbc::Src::R(nf_temp, dxbc::Src::kXXXX),
+                  dxbc::Src::R(mult_temp).Select(c), dxbc::Src::R(nf_temp, dxbc::Src::kWWWW));
+        a_.OpMovC(dxbc::Dest::R(nf_temp, 0b0010), dxbc::Src::R(nf_temp, dxbc::Src::kXXXX),
+                  dxbc::Src::R(signs_raw_temp).Select(c), dxbc::Src::R(nf_temp, dxbc::Src::kYYYY));
+      }
+      // A signed channel (TextureSign::kSigned) holds -max/2...max/2: the host view is SNORM.
+      a_.OpIEq(dxbc::Dest::R(nf_temp, 0b0001), dxbc::Src::R(nf_temp, dxbc::Src::kYYYY),
+               dxbc::Src::LU(uint32_t(xenos::TextureSign::kSigned)));
+      a_.OpMAd(dxbc::Dest::R(round_temp, 0b0010), dxbc::Src::R(nf_temp, dxbc::Src::kWWWW), dxbc::Src::LF(0.5f),
+               dxbc::Src::LF(-0.5f));
+      // Formats without a maximum (floating point, multiplier 1) stay unchanged when signed.
+      a_.OpMax(dxbc::Dest::R(round_temp, 0b0010), dxbc::Src::R(round_temp, dxbc::Src::kYYYY), dxbc::Src::LF(1.0f));
+      a_.OpMovC(dxbc::Dest::R(nf_temp, 0b1000), dxbc::Src::R(nf_temp, dxbc::Src::kXXXX),
+                dxbc::Src::R(round_temp, dxbc::Src::kYYYY), dxbc::Src::R(nf_temp, dxbc::Src::kWWWW));
+      dxbc::Dest component_dest(dxbc::Dest::R(system_temp_result_, 1 << i));
+      a_.OpMul(component_dest, dxbc::Src::R(system_temp_result_).Select(i),
+               dxbc::Src::R(nf_temp, dxbc::Src::kWWWW));
+      a_.OpRoundNE(dxbc::Dest::R(round_temp, 0b0001), dxbc::Src::R(system_temp_result_).Select(i));
+      a_.OpNE(dxbc::Dest::R(nf_temp, 0b0001), dxbc::Src::R(nf_temp, dxbc::Src::kWWWW), dxbc::Src::LF(1.0f));
+      a_.OpMovC(component_dest, dxbc::Src::R(nf_temp, dxbc::Src::kXXXX), dxbc::Src::R(round_temp, dxbc::Src::kXXXX),
+                dxbc::Src::R(system_temp_result_).Select(i));
+    }
+    a_.OpEndIf();
+    // Release nf_temp, mult_temp, round_temp and signs_raw_temp.
+    PopSystemTemp(4);
+  }
+
   if (instr.opcode == FetchOpcode::kTextureFetch) {
     // Apply the result exponent bias.
     uint32_t exp_adjust_temp = PushSystemTemp();
-- 
2.55.0.windows.5


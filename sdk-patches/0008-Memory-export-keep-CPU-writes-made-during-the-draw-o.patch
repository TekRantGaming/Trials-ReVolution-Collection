index fe410b5..8cedaaf 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -4119,9 +4119,15 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
   // Synchronize the memory pages backing memory scatter export streams, and
   // calculate the range that includes the streams for the buffer barrier.
   uint32_t memexport_extent_start = UINT32_MAX, memexport_extent_end = 0;
+  // Vertex data exports (memexport_vertex_whole_stream off) only need the stream resident: CPU data in pages the
+  // export doesn't touch is uploaded when used, and CPU writes to exported pages are merged (see SharedMemory).
+  bool memexport_whole_stream = memexport_used_pixel || REXCVAR_GET(memexport_vertex_whole_stream);
   for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
     uint32_t memexport_range_base_bytes = memexport_range.base_address_dwords << 2;
-    if (!shared_memory_->RequestRange(memexport_range_base_bytes, memexport_range.size_bytes)) {
+    if (!(memexport_whole_stream
+              ? shared_memory_->RequestRange(memexport_range_base_bytes, memexport_range.size_bytes)
+              : shared_memory_->EnsureRangeResident(memexport_range_base_bytes,
+                                                    memexport_range.size_bytes))) {
       REXGPU_ERROR(
           "Failed to request memexport stream at 0x{:08X} (size {}) in the "
           "shared memory",
@@ -4245,14 +4251,15 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
 
   // Invalidate textures in memexported memory and watch for changes.
   if (!memexport_ranges_.empty()) {
+    // Only exports that may be texture data invalidate the textures in the stream.
     for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
       shared_memory_->RangeWrittenByGpu(memexport_range.base_address_dwords << 2,
-                                        memexport_range.size_bytes);
+                                        memexport_range.size_bytes, true, memexport_whole_stream);
     }
   } else if (memexport_writes_possible) {
     // Stream constants can be invalid or dynamic, so exact destinations may be
     // unknown. Keep invalidation conservative in this case.
-    shared_memory_->RangeWrittenByGpu(0, SharedMemory::kBufferSize);
+    shared_memory_->RangeWrittenByGpu(0, SharedMemory::kBufferSize, true);
   }
 
   if (IsReadbackMemexportEnabled(REXCVAR_GET(vulkan_readback_memexport)) &&

From 6b62d3e91c78e99710576b324bbf947d0e40579f Mon Sep 17 00:00:00 2001
From: TekRantGaming <craigferels896@gmail.com>
Date: Tue, 27 Oct 2026 16:14:07 +0000
Subject: [PATCH 8/8] Memory export: keep CPU writes made during the draw,
 optional vertex data streams

After a memory export draw the whole destination stream was marked valid, losing CPU writes made by guest threads
since RequestRange uploaded it; now only pages still valid are marked as holding GPU data.

memexport_vertex_whole_stream (default on, as before): off, vertex shader exports only make their stream resident
instead of uploading it whole, and don't invalidate the textures in it. Trials Evolution's particle vertex shaders
export a few KB into 8 to 16 MB streams that also hold menu and level textures; uploading and invalidating the
whole stream for every particle draw corrupted those textures.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/graphics/flags.h              |  1 +
 include/rex/graphics/shared_memory.h      |  9 ++++-
 src/graphics/command_processor.cpp        |  6 +++
 src/graphics/d3d12/command_processor.cpp  | 16 ++++++--
 src/graphics/shared_memory.cpp            | 46 ++++++++++++++++++++---
 src/graphics/vulkan/command_processor.cpp | 13 +++++--
 6 files changed, 78 insertions(+), 13 deletions(-)

diff --git a/include/rex/graphics/flags.h b/include/rex/graphics/flags.h
index 2fb8d24..807be67 100644
--- a/include/rex/graphics/flags.h
+++ b/include/rex/graphics/flags.h
@@ -30,6 +30,7 @@ REXCVAR_DECLARE(std::string, readback_resolve);
 REXCVAR_DECLARE(bool, readback_resolve_half_pixel_offset);
 REXCVAR_DECLARE(bool, readback_memexport);
 REXCVAR_DECLARE(bool, readback_memexport_fast);
+REXCVAR_DECLARE(bool, memexport_vertex_whole_stream);
 REXCVAR_DECLARE(bool, occlusion_query_enable);
 REXCVAR_DECLARE(int32_t, query_occlusion_fake_sample_count);
 
diff --git a/include/rex/graphics/shared_memory.h b/include/rex/graphics/shared_memory.h
index 3de4b9e..5ff4145 100644
--- a/include/rex/graphics/shared_memory.h
+++ b/include/rex/graphics/shared_memory.h
@@ -95,7 +95,14 @@ class SharedMemory {
   // be called, to make sure, if the GPU writes don't overwrite *everything* in
   // the pages they touch, the CPU data is properly loaded to the unmodified
   // regions in those pages.
-  void RangeWrittenByGpu(uint32_t start, uint32_t length);
+  // may_be_partial: the range is only where the GPU may have written (memory export to a whole stream), so pages
+  // the CPU has written since RequestRange stay invalid instead of being marked valid without their CPU data.
+  // Makes the range resident in the buffer without uploading anything (for GPU writes that may not cover it all).
+  bool EnsureRangeResident(uint32_t start, uint32_t length);
+
+  // fire_watches false: only mark the pages (memory export from vertex shaders, read as vertex data, not textures).
+  void RangeWrittenByGpu(uint32_t start, uint32_t length, bool may_be_partial = false,
+                         bool fire_watches = true);
 
  protected:
   SharedMemory(memory::Memory& memory);
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 1b3acdb..1fd9207 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -69,6 +69,12 @@ REXCVAR_DEFINE_BOOL(readback_memexport_fast, true, "GPU",
                     "automatic fallback to full synchronous readback")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
+REXCVAR_DEFINE_BOOL(memexport_vertex_whole_stream, true, "GPU",
+                    "Vertex shader memexport treats its whole destination stream as written: uploads it before the "
+                    "draw and invalidates the textures in it. Turn off for titles whose vertex shaders export only "
+                    "vertex data (particles) into large streams that also hold textures")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 REXCVAR_DEFINE_INT32(query_occlusion_fake_sample_count, 1000, "GPU",
                      "Fake sample count for occlusion queries")
     .range(1, 100000)
diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index e28a4ef..0dd8782 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -2675,9 +2675,16 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
   if (memexport_used_pixel) {
     draw_util::AddMemExportRanges(regs, *pixel_shader, memexport_ranges_);
   }
+  // Vertex data exports (memexport_vertex_whole_stream off) only need the stream resident: CPU data in pages the
+  // export doesn't touch is uploaded when used, and CPU writes to exported pages are merged (see SharedMemory).
+  bool memexport_whole_stream =
+      memexport_used_pixel || REXCVAR_GET(memexport_vertex_whole_stream);
   for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
-    if (!shared_memory_->RequestRange(memexport_range.base_address_dwords << 2,
-                                      memexport_range.size_bytes)) {
+    if (!(memexport_whole_stream
+              ? shared_memory_->RequestRange(memexport_range.base_address_dwords << 2,
+                                             memexport_range.size_bytes)
+              : shared_memory_->EnsureRangeResident(memexport_range.base_address_dwords << 2,
+                                                    memexport_range.size_bytes))) {
       REXGPU_ERROR(
           "Failed to request memexport stream at 0x{:08X} (size {}) in the "
           "shared memory",
@@ -2843,14 +2850,15 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
     shared_memory_->MarkUAVWritesCommitNeeded();
     // Invalidate textures in memexported memory and watch for changes.
     if (!memexport_ranges_.empty()) {
+      // Only exports that may be texture data invalidate the textures in the stream.
       for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
         shared_memory_->RangeWrittenByGpu(memexport_range.base_address_dwords << 2,
-                                          memexport_range.size_bytes);
+                                          memexport_range.size_bytes, true, memexport_whole_stream);
       }
     } else {
       // Stream constants can be invalid or dynamic, so exact destinations may
       // be unknown. Keep invalidation conservative in this case.
-      shared_memory_->RangeWrittenByGpu(0, SharedMemory::kBufferSize);
+      shared_memory_->RangeWrittenByGpu(0, SharedMemory::kBufferSize, true);
     }
     if (IsReadbackMemexportEnabled(REXCVAR_GET(d3d12_readback_memexport)) &&
         !memexport_ranges_.empty()) {
diff --git a/src/graphics/shared_memory.cpp b/src/graphics/shared_memory.cpp
index fc65a8c..a776aaa 100644
--- a/src/graphics/shared_memory.cpp
+++ b/src/graphics/shared_memory.cpp
@@ -255,7 +255,18 @@ void SharedMemory::FireWatches(uint32_t page_first, uint32_t page_last, bool inv
   }
 }
 
-void SharedMemory::RangeWrittenByGpu(uint32_t start, uint32_t length) {
+bool SharedMemory::EnsureRangeResident(uint32_t start, uint32_t length) {
+  if (length == 0) {
+    return true;
+  }
+  if (start > kBufferSize || (kBufferSize - start) < length) {
+    return false;
+  }
+  return EnsureHostGpuMemoryAllocated(start, length);
+}
+
+void SharedMemory::RangeWrittenByGpu(uint32_t start, uint32_t length, bool may_be_partial,
+                                     bool fire_watches) {
   if (length == 0 || start >= kBufferSize) {
     return;
   }
@@ -266,11 +277,36 @@ void SharedMemory::RangeWrittenByGpu(uint32_t start, uint32_t length) {
 
   // Trigger modification callbacks so, for instance, resolved data is loaded to
   // the texture.
-  FireWatches(page_first, page_last, true);
+  if (fire_watches) {
+    FireWatches(page_first, page_last, true);
+  }
 
-  // Mark the range as valid (so pages are not reuploaded until modified by the
-  // CPU) and watch it so the CPU can reuse it and this will be caught.
-  MakeRangeValid(start, length, true);
+  if (!may_be_partial) {
+    // Mark the range as valid (so pages are not reuploaded until modified by the
+    // CPU) and watch it so the CPU can reuse it and this will be caught.
+    MakeRangeValid(start, length, true);
+    return;
+  }
+
+  // The range was made valid by RequestRange before the draw, but guest threads keep running while the draw is
+  // prepared: a page they wrote since then is invalid again and holds CPU data the buffer doesn't have yet. Only the
+  // pages still valid are marked as holding GPU data; the rest stay invalid and are uploaded when next requested.
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    uint32_t block_first = page_first >> 6;
+    uint32_t block_last = page_last >> 6;
+    for (uint32_t i = block_first; i <= block_last; ++i) {
+      uint64_t range_bits = UINT64_MAX;
+      if (i == block_first) {
+        range_bits &= ~((uint64_t(1) << (page_first & 63)) - 1);
+      }
+      if (i == block_last && (page_last & 63) != 63) {
+        range_bits &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+      }
+      system_page_flags_valid_and_gpu_written_[i] |= system_page_flags_valid_[i] & range_bits;
+    }
+  }
+  // Valid pages are already watched (made valid by an upload or an earlier GPU write).
 }
 
 bool SharedMemory::AllocateSparseHostGpuMemoryRange(uint32_t offset_allocations,

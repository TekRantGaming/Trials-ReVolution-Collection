+// Storage-image destination load of untiled unscaled 8bpp textures (the planes of movies), through an R8_UINT view.
+const char kTextureLoad8bpbStorageDestShaderSource[] = R"(#version 450
+layout(local_size_x = 4, local_size_y = 32, local_size_z = 1) in;
+layout(set = 1, binding = 0, std430) readonly buffer XeTextureLoadSource {
+  uvec4 data[];
+} xe_src;
+layout(set = 0, binding = 0, r8ui) uniform writeonly uimage2D xe_dest;
+layout(push_constant, std430) uniform XeTextureLoadConstants {
+  uint info;
+  uint guest_offset;
+  uint guest_pitch_aligned;
+  uint guest_z_stride_block_rows_aligned;
+  uvec3 size_blocks;
+  uint host_offset;
+  uint host_pitch;
+  uint height_texels;
+} xe;
+void main() {
+  const uint blocks_per_thread = BLOCKS_PER_THREAD;
+  uint block_y = gl_GlobalInvocationID.y;
+  if (block_y >= xe.size_blocks.y) {
+    return;
+  }
+  uint row = xe.guest_offset + block_y * xe.guest_pitch_aligned;
+  uint block_x = gl_GlobalInvocationID.x * blocks_per_thread;
+  for (uint i = 0u; i < blocks_per_thread; ++i) {
+    uint x = block_x + i;
+    if (x >= xe.size_blocks.x) {
+      break;
+    }
+    uint address = row + x;
+    uint word = xe_src.data[address >> 4u][(address >> 2u) & 3u];
+    imageStore(xe_dest, ivec2(int(x), int(block_y)), uvec4((word >> ((address & 3u) << 3u)) & 255u, 0u, 0u, 0u));
+  }
+}
+)";
+
 const char kTextureLoad32bpbScaledTexelBufferShaderSource[] = R"(#version 450
 layout(local_size_x = 4, local_size_y = 32, local_size_z = 1) in;
 layout(set = 1, binding = 0) uniform utextureBuffer xe_src;
@@ -1512,6 +1553,9 @@
       case VK_FORMAT_B10G11R11_UFLOAT_PACK32:

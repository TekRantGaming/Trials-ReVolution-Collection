+void SetNativeCommandSink(NativeCommandSink sink, void* user_data) {
+  g_command_sink_user_data.store(user_data);
+  g_command_sink.store(sink);
+  // Memory exports must reach guest memory: the renderer reads textures from there.
+  if (sink) rex::cvar::SetFlagByName("readback_memexport", "true");
+}
+
+bool HasNativeCommandSink() { return g_command_sink.load() != nullptr; }
+
+bool SendNativeCommand(const NativeCommandEvent& event) {
+  NativeCommandSink sink = g_command_sink.load();
+  return sink && sink(event, g_command_sink_user_data.load());
+}

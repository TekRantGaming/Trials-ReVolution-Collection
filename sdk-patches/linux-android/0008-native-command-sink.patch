+// ---- Native command sink ----------------------------------------------------
+// For titles whose state only exists in the command stream: the command
+// processor hands over every draw, resolve and swap with the register file and
+// the bound shaders.
+struct NativeCommandEvent {
+  enum class Kind : uint32_t { kDraw, kCopy, kSwap } kind = Kind::kDraw;
+  const uint32_t* registers = nullptr;
+  uint32_t primitive = 0;
+  uint32_t count = 0;
+  bool indexed = false;
+  bool indices_32bit = false;
+  uint32_t index_address = 0;
+  uint32_t index_endian = 0;
+  uint32_t index_size = 0;  // bytes
+  const uint32_t* vs_ucode = nullptr;
+  uint32_t vs_dwords = 0;
+  uint64_t vs_hash = 0;
+  const uint32_t* ps_ucode = nullptr;
+  uint32_t ps_dwords = 0;
+  uint64_t ps_hash = 0;
+  uint32_t front_buffer = 0, width = 0, height = 0;  // kSwap
+};
+// Returns true when it has dealt with the event, so the emulated path skips it.
+using NativeCommandSink = bool (*)(const NativeCommandEvent& event, void* user_data);
+void SetNativeCommandSink(NativeCommandSink sink, void* user_data);
+bool HasNativeCommandSink();
+bool SendNativeCommand(const NativeCommandEvent& event);

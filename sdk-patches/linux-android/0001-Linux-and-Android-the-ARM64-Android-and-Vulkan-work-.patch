+void ImGuiDrawer::ProcessImGuiTextureRequests(ImDrawData* data) {
+  if (!data->Textures) {
+    return;
+  }
+  for (ImTextureData* tex : *data->Textures) {
+    switch (tex->Status) {
+      case ImTextureStatus_WantCreate:
+      case ImTextureStatus_WantUpdates: {

+// NDC_DIRECTION_Y_XE, assuming a positive viewport height, is:
+// *  1.0 if +out_position_xe.y is towards +in_pixel_coord_xe.y,
+// * -1.0 if +out_position_xe.y is towards -in_pixel_coord_xe.y.
+#if SHADING_LANGUAGE_GLSL_XE
+  #define NDC_DIRECTION_Y_XE 1.0f
+#else
+  #define NDC_DIRECTION_Y_XE -1.0f
+#endif  // SHADING_LANGUAGE_GLSL_XE

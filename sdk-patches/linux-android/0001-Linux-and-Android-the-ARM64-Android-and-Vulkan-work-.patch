+  if (e.is_shift_pressed()) {
+    flags |= X_INPUT_KEYSTROKE_SHIFT;
+  }
+  if (e.is_ctrl_pressed()) {
+    flags |= X_INPUT_KEYSTROKE_CTRL;
+  }
+  if (e.is_alt_pressed()) {
+    flags |= X_INPUT_KEYSTROKE_ALT;
+  }
+  ks.flags = flags;

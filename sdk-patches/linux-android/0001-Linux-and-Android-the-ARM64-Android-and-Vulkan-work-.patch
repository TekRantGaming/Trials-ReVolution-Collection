@@ -0,0 +1,226 @@
+/**
+ * @file        ui/overlay/quit_overlay.cpp
+ *
+ * @brief       "Quit the game?" confirmation dialog. See quit_overlay.h.
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.

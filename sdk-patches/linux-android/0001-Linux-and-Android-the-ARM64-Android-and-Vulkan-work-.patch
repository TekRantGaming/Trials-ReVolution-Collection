+uint32_t TextureCache::RecentTextureIndex(const TextureKey& key) {
+  static_assert(sizeof(TextureKey) % sizeof(uint32_t) == 0);
+  uint32_t words[sizeof(TextureKey) / sizeof(uint32_t)];

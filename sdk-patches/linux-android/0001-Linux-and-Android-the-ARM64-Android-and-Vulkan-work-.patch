+template <size_t N>
+int NearestValueIndex(const std::array<double, N>& values, double value) {
+  int best = 0;
+  double best_err = std::abs(value - values[0]);
+  for (size_t i = 1; i < N; ++i) {
+    const double err = std::abs(value - values[i]);
+    if (err < best_err) {
+      best = static_cast<int>(i);
+      best_err = err;
+    }
+  }
+  return best;
+}

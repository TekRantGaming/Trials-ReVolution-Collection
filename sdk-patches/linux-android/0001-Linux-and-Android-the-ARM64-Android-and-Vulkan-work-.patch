+bool ConsumeResolveDecisionLogBudget() {
+  const int32_t remaining = REXCVAR_GET(vulkan_debug_log_resolve_decisions_remaining);
+  if (remaining <= 0) {
+    return false;
+  }
+  REXCVAR_SET(vulkan_debug_log_resolve_decisions_remaining, remaining - 1);
+  return true;
+}

+void MnkInputDriver::EnqueueRawKeystroke(const rex::ui::KeyEvent& e, bool down) {
+  X_INPUT_KEYSTROKE ks = {};
+  ks.virtual_key = static_cast<uint16_t>(e.virtual_key());

+    uint32_t caller_sp = rex::memory::load_and_swap<uint32_t>(base + sp);
+    if (!caller_sp || caller_sp <= sp) break;
+    uint32_t saved_lr = rex::memory::load_and_swap<uint32_t>(base + caller_sp - 8);

+        if (parsed <= static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) {
+          config.insert_or_assign(entry.name, static_cast<int64_t>(parsed));
+        } else {
+          config.insert_or_assign(entry.name, value);

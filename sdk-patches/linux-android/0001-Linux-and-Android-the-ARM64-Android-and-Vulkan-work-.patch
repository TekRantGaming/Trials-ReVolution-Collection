+    case -1:
+      return rex::thread::ThreadPriority::kBelowNormal;
+    case 1:
+      return rex::thread::ThreadPriority::kAboveNormal;
+    case 2:
+      return rex::thread::ThreadPriority::kHighest;
+    case 0:
+    default:
+      return rex::thread::ThreadPriority::kNormal;
+  }
+}

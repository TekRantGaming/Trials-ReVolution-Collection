+// Version of XeDXT58StepRowToA8 that returns values packed in low 8 bits of
+// 16-bit parts, for DXN decompression.
+uint2_xe XeDXT58StepRowToA8In16(uint2_xe end, uint weights_high) {
+  uint weights_low = ~weights_high;

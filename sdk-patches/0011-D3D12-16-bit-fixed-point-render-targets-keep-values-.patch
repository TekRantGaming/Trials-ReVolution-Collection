From 52a1f76cc6120ac416ee1d50bb200fa9f75a84ac Mon Sep 17 00:00:00 2001
From: TekRantGaming <craigferels896@gmail.com>
Date: Thu, 29 Oct 2026 01:08:30 +0000
Subject: [PATCH] D3D12: 16 bit fixed point render targets keep values below -1
 (Xenia Canary 42c2b880e)

Resolves clamped k_16_16 and k_16_16_16_16 EDRAM values to -1 although the format holds -32 to 32 with 10
fractional bits. Trials Evolution and Trials Fusion store their variance shadow map moments in that range, so every
caster in the near half of a cascade was flattened to one depth and shadows were missing or partial. Unpack and pack
now use 10 fractional bits without the clamp, host render targets scale by 1024/32767 and ROV packs with rounding
half up, as in Xenia Canary.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/graphics/d3d12/command_processor.cpp      |   11 +-
 src/graphics/pipeline/render_target/cache.cpp |    3 +-
 .../pipeline/shader/dxbc_translator_om.cpp    |   13 +-
 .../d3d12_5_1/resolve_full_16bpp_cs.h         | 5144 ++++++++--------
 .../d3d12_5_1/resolve_full_16bpp_scaled_cs.h  | 5440 ++++++++--------
 .../d3d12_5_1/resolve_full_32bpp_cs.h         | 5182 ++++++++--------
 .../d3d12_5_1/resolve_full_32bpp_scaled_cs.h  | 5462 ++++++++---------
 .../shaders/xesl/gpu/pixel_formats.xesli      |   16 +-
 8 files changed, 10267 insertions(+), 11004 deletions(-)

diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 64619b9..dd42dfe 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -4061,17 +4061,18 @@ void D3D12CommandProcessor::UpdateSystemConstantValues(
     reg::RB_COLOR_INFO color_info = color_infos[i];
     // Exponent bias is in bits 20:25 of RB_COLOR_INFO.
     int32_t color_exp_bias = color_info.color_exp_bias;
+    auto color_exp_bias_scale =
+        rex::memory::Reinterpret<float>(int32_t(0x3F800000 + (color_exp_bias << 23)));
     if (color_info.color_format == xenos::ColorRenderTargetFormat::k_16_16 ||
         color_info.color_format == xenos::ColorRenderTargetFormat::k_16_16_16_16) {
       if (render_target_cache_->GetPath() == RenderTargetCache::Path::kHostRenderTargets &&
           !render_target_cache_->IsFixed16TruncatedToMinus1To1()) {
-        // Remap from -32...32 to -1...1 by dividing the output values by 32,
-        // losing blending correctness, but getting the full range.
-        color_exp_bias -= 5;
+        // Remap to -1...1 by scaling the output values by 1024/32767 (the SNORM integer is then the guest's
+        // fixed-point value with 10 fractional bits), losing blending correctness, but getting the full range
+        // (Xenia Canary 42c2b880e).
+        color_exp_bias_scale *= 1024.0f / 32767.0f;
       }
     }
-    auto color_exp_bias_scale =
-        rex::memory::Reinterpret<float>(int32_t(0x3F800000 + (color_exp_bias << 23)));
     dirty |= system_constants_.color_exp_bias[i] != color_exp_bias_scale;
     system_constants_.color_exp_bias[i] = color_exp_bias_scale;
     if (edram_rov_used) {
diff --git a/src/graphics/pipeline/render_target/cache.cpp b/src/graphics/pipeline/render_target/cache.cpp
index 953c5fd..ab305ac 100644
--- a/src/graphics/pipeline/render_target/cache.cpp
+++ b/src/graphics/pipeline/render_target/cache.cpp
@@ -94,8 +94,9 @@ void RenderTargetCache::GetPSIColorFormatInfo(xenos::ColorRenderTargetFormat for
       // how Direct3D 11.3 functional specification defines SNorm conversion
       // (NaN should be 0, not the lowest negative number), and that needs to be
       // handled separately.
+      // -32 is 0x8000 on real hardware.
       clamp_rgb_low = clamp_alpha_low = -32.0f;
-      clamp_rgb_high = clamp_alpha_high = 32.0f;
+      clamp_rgb_high = clamp_alpha_high = 32767.0f / 1024.0f;
       if (!(write_mask & 0b0001)) {
         keep_mask_low |= 0xFFFFu;
       }
diff --git a/src/graphics/pipeline/shader/dxbc_translator_om.cpp b/src/graphics/pipeline/shader/dxbc_translator_om.cpp
index a7d508a..41187e6 100644
--- a/src/graphics/pipeline/shader/dxbc_translator_om.cpp
+++ b/src/graphics/pipeline/shader/dxbc_translator_om.cpp
@@ -1168,8 +1168,8 @@ void DxbcShaderTranslator::ROV_UnpackColor(uint32_t rt_index, uint32_t packed_te
               dxbc::Src::R(packed_temp, 0b01010000 + packed_temp_components * 0b01010101));
     // Convert from fixed-point.
     a_.OpIToF(color_components_dest, dxbc::Src::R(color_temp));
-    // Normalize.
-    a_.OpMul(color_components_dest, dxbc::Src::R(color_temp), dxbc::Src::LF(32.0f / 32767.0f));
+    // 10 fractional bits.
+    a_.OpMul(color_components_dest, dxbc::Src::R(color_temp), dxbc::Src::LF(1.0f / 1024.0f));
     a_.OpBreak();
   }
 
@@ -1317,12 +1317,9 @@ void DxbcShaderTranslator::ROV_PackPreClampedColor(uint32_t rt_index, uint32_t c
         RenderTargetCache::AddPSIColorFormatFlags(i ? xenos::ColorRenderTargetFormat::k_16_16_16_16
                                                     : xenos::ColorRenderTargetFormat::k_16_16)));
     for (uint32_t j = 0; j < (uint32_t(2) << i); ++j) {
-      // Denormalize and convert to fixed-point, making 0.5 with the proper sign
-      // in temp2.
-      a_.OpGE(temp2_dest, dxbc::Src::R(color_temp).Select(j), dxbc::Src::LF(0.0f));
-      a_.OpMovC(temp2_dest, temp2_src, dxbc::Src::LF(0.5f), dxbc::Src::LF(-0.5f));
-      a_.OpMAd(temp1_dest, dxbc::Src::R(color_temp).Select(j), dxbc::Src::LF(32767.0f / 32.0f),
-               temp2_src);
+      // 10 fractional bits, rounded half up (-0.5 packs to 0, -32 to 0x8000).
+      a_.OpMAd(temp1_dest, dxbc::Src::R(color_temp).Select(j), dxbc::Src::LF(1024.0f), dxbc::Src::LF(0.5f));
+      a_.OpRoundNI(temp1_dest, temp1_src);
       dxbc::Dest packed_dest_half(
           dxbc::Dest::R(packed_temp, 1 << (packed_temp_components + (j >> 1))));
       // Convert to fixed-point.

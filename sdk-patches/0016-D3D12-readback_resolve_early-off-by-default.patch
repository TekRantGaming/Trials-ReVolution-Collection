From 697865c0ebecd278f96b2805120e55b37e5d630d Mon Sep 17 00:00:00 2001
From: TekRantGaming <craigferels896@gmail.com>
Date: Thu, 29 Oct 2026 06:32:27 +0000
Subject: [PATCH] D3D12: readback_resolve_early off by default

The submission it starts after each copy cost Trials Evolution 14 FPS in
races at 4K with NIS (45 instead of 59). The readback range fix stays.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/graphics/d3d12/command_processor.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 84ba1ee..7681e75 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -45,10 +45,11 @@ REXCVAR_DEFINE_BOOL(d3d12_readback_resolve, false, "GPU/D3D12",
                     "Read render-to-texture results on the CPU")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
-REXCVAR_DEFINE_BOOL(readback_resolve_early, true, "GPU",
+REXCVAR_DEFINE_BOOL(readback_resolve_early, false, "GPU",
                     "readback_resolve fast: copy each resolve into guest memory as soon as the GPU has written it, "
                     "instead of handing the game the previous resolve of that buffer (data two frames old for "
-                    "buffers the game alternates between)");
+                    "buffers the game alternates between). Off: the submission it starts after each copy cost "
+                    "Trials Evolution 14 FPS at 4K");
 REXCVAR_DEFINE_INT32(readback_resolve_scaled_max_kb, 0, "GPU",
                      "With resolution scaling, read back only resolves up to this many KB (0: all). Each scaled "
                      "readback is downscaled first, which is costly; games that read only small results on the CPU "
-- 
2.55.0.windows.5


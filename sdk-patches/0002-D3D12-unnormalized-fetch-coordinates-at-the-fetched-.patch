diff --git a/src/graphics/pipeline/shader/dxbc_translator_fetch.cpp b/src/graphics/pipeline/shader/dxbc_translator_fetch.cpp
index 8fb2e32..573858f 100644
--- a/src/graphics/pipeline/shader/dxbc_translator_fetch.cpp
+++ b/src/graphics/pipeline/shader/dxbc_translator_fetch.cpp
@@ -1083,6 +1083,20 @@ void DxbcShaderTranslator::ProcessTextureFetchInstruction(
                     coord_operand.SelectFromSwizzled(2));
         }
       }
+      if (instr.attributes.use_register_lod && !use_computed_lod &&
+          instr.attributes.mip_filter != xenos::TextureFilter::kBaseMap) {
+        // Unnormalized coordinates are texels of the mip level being fetched, not of the base level, so scale the
+        // normalized XY by 2^level. Trials Fusion copies its virtual texture page table between levels this way.
+        uint32_t level_temp = PushSystemTemp();
+        a_.OpRoundNE(dxbc::Dest::R(level_temp, 0b0001), dxbc::Src::R(system_temp_grad_h_lod_, dxbc::Src::kWWWW));
+        a_.OpMax(dxbc::Dest::R(level_temp, 0b0001), dxbc::Src::R(level_temp, dxbc::Src::kXXXX),
+                 dxbc::Src::LF(0.0f));
+        a_.OpExp(dxbc::Dest::R(level_temp, 0b0001), dxbc::Src::R(level_temp, dxbc::Src::kXXXX));
+        a_.OpMul(dxbc::Dest::R(coord_and_sampler_temp, normalized_components & 0b011),
+                 dxbc::Src::R(coord_and_sampler_temp), dxbc::Src::R(level_temp, dxbc::Src::kXXXX));
+        // Release level_temp.
+        PopSystemTemp();
+      }
     } else {
       // Normalized coordinates - apply offsets to XY or copy them to
       // coord_and_sampler_temp, and if stacked, denormalize Z.

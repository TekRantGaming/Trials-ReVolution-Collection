@@ -382,6 +383,17 @@ class D3D12CommandProcessor : public CommandProcessor {
     uint64_t last_used_frame = 0;
   };
   void EvictOldReadbackBuffers(std::unordered_map<uint64_t, ReadbackBuffer>& buffer_map);
+  // readback_resolve fast: resolve copies waiting for the GPU. Each one goes into guest memory as soon as its
+  // submission completes (checked on every draw, copy and swap, and while waiting for guest commands).
+  struct PendingResolveReadback {
+    uint64_t key;
+    uint32_t index;
+    uint64_t submission;
+    uint32_t address;
+    uint32_t length;
+  };
+  std::vector<PendingResolveReadback> pending_resolve_readbacks_;
+  void DeliverCompletedResolveReadbacks();
   static constexpr uint32_t kReadbackBufferSizeIncrement = 16 * 1024 * 1024;
   static constexpr size_t kMaxReadbackBuffers = 256;
   static constexpr uint64_t kReadbackBufferEvictionAgeFrames = 60;

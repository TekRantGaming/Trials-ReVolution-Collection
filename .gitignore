# The owner's game packages, what is extracted from them and the code generated from them: never commit.
/Trials-*-Recomp/
/DLC/
*.xex
*.pak
*.xwb
/games/*/assets/
/games/*/generated/
# Private developer aids and reference material.
/games/*/dev/
/devtools/
/ref/

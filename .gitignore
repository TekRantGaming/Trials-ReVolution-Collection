/DECISIONS.md
# Build output, logs, test runs.
/build/
/runs/
/dist/
/games/*/out/
/games/*/codegen.log
/games/*/build*.log
*.log
# The ReXGlue SDK install (a junction to the patched SDK).
/tools/rexglue/
/games/*/image.bin
/games/*/missing_funcs.all.toml
# Linux and Android: the SDK tools/setup_sdk.sh prepares, build output.
/third_party/rexglue-sdk/
/out/
/build-linux/

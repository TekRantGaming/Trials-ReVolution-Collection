+// A level the shader picked (setTexLOD), and texel rather than normalized coordinates.
+float4 tfetch2DLod(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord, float2 offset, float lod, bool denormalized)
+{
+    Texture2D<float4> texture = g_Texture2DDescriptorHeap[resourceDescriptorIndex];
+    uint width, height, levels;
+    texture.GetDimensions(0, width, height, levels);
+    // A level past the last one reads zero (the page table's seed frames fetch level 8 of 8 to start a level over).
+    if (uint(max(lod, 0.0)) >= levels)
+        return 0.0;
+    texture.GetDimensions(uint(max(lod, 0.0)), width, height, levels);
+    float2 dimensions = float2(width, height);
+    float2 uv = denormalized ? (texCoord + offset) / dimensions : texCoord + offset / dimensions;
+    return texture.SampleLevel(g_SamplerDescriptorHeap[samplerDescriptorIndex], uv, lod);
+}
+
+float compTexLod2D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord)
+{
+    Texture2D<float4> texture = g_Texture2DDescriptorHeap[resourceDescriptorIndex];
+    return texture.CalculateLevelOfDetail(g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord);
+}

+#ifdef __spirv__
+
+// Memory export, as the SDK's translator does it: eA holds the stream (base address, index, format, count) in the
+// bits of a float4, eM0 to eM4 the elements, written in the format and byte order the stream names.
+uint exportSwap(uint v, uint endian)
+{
+    if (endian == 1)
+        return ((v & 0x00FF00FFu) << 8) | ((v >> 8) & 0x00FF00FFu);
+    if (endian == 2 || endian >= 4)
+        return (v << 24) | ((v & 0xFF00u) << 8) | ((v >> 8) & 0xFF00u) | (v >> 24);
+    if (endian == 3)
+        return (v << 16) | (v >> 16);
+    return v;
+}
+
+uint4 exportSwap128(uint4 v, uint endian)
+{
+    if (endian == 4)
+        v = v.yxwz;
+    else if (endian == 5)
+        v = v.wzyx;
+    return uint4(exportSwap(v.x, endian), exportSwap(v.y, endian), exportSwap(v.z, endian), exportSwap(v.w, endian));
+}
+
+// The element as dwords; log2Size is its size in bytes (7 when the format is not one memory export takes).
+uint4 exportPack(float4 v, uint format, bool swapRedBlue, bool isSigned, bool isNorm, out uint log2Size)
+{
+    if (swapRedBlue)
+        v = v.zyxw;
+    uint4 widths = 0;
+    log2Size = 2;
+    switch (format)
+    {
+    case 2: case 8: case 9: widths = uint4(8, 0, 0, 0); log2Size = 0; break;
+    case 3: widths = uint4(5, 5, 5, 1); log2Size = 1; break;
+    case 4: widths = uint4(5, 6, 5, 0); log2Size = 1; break;
+    case 5: widths = uint4(5, 5, 6, 0); log2Size = 1; break;
+    case 6: case 14: case 50: widths = uint4(8, 8, 8, 8); break;
+    case 7: case 54: widths = uint4(10, 10, 10, 2); break;
+    case 10: widths = uint4(8, 8, 0, 0); log2Size = 1; break;
+    case 15: widths = uint4(4, 4, 4, 4); log2Size = 1; break;
+    case 16: case 55: widths = uint4(11, 11, 10, 0); break;
+    case 17: case 56: widths = uint4(10, 11, 11, 0); break;
+    case 24: widths = uint4(16, 0, 0, 0); log2Size = 1; break;
+    case 25: widths = uint4(16, 16, 0, 0); break;
+    case 26: widths = uint4(16, 16, 16, 16); log2Size = 3; break;
+    case 30: log2Size = 1; return uint4(f32tof16(v.x), 0, 0, 0);
+    case 31: log2Size = 2; return uint4(f32tof16(v.x) | (f32tof16(v.y) << 16), 0, 0, 0);
+    case 32: log2Size = 3; return uint4(f32tof16(v.x) | (f32tof16(v.y) << 16), f32tof16(v.z) | (f32tof16(v.w) << 16), 0, 0);
+    case 36: log2Size = 2; return uint4(asuint(v.x), 0, 0, 0);
+    case 37: log2Size = 3; return uint4(asuint(v.x), asuint(v.y), 0, 0);
+    case 38: log2Size = 4; return asuint(v);
+    default: log2Size = 7; return 0;
+    }
+    uint4 packed = 0;
+    uint offset = 0;
+    for (uint c = 0; c < 4; ++c)
+    {
+        uint width = widths[c];
+        if (width == 0)
+            break;
+        float f = isnan(v[c]) ? 0.0 : v[c];
+        uint bits;
+        if (isSigned)
+        {
+            if (isNorm)
+                f = clamp(f, -1.0, 1.0) * float((1u << (width - 1)) - 1);
+            bits = uint(int(f + (f < 0.0 ? -0.5 : 0.5)));
+        }
+        else
+        {
+            if (isNorm)
+                f = saturate(f) * float((1u << width) - 1);
+            bits = uint(max(f, 0.0) + 0.5);
+        }
+        bits &= (1u << width) - 1;
+        // Two 16-bit components share each dword.
+        uint dword = log2Size == 3 ? c / 2 : 0;
+        uint shift = log2Size == 3 ? (c & 1) * 16 : offset;
+        packed[dword] |= bits << shift;
+        offset += width;
+    }
+    return packed;
+}
+
+// Where a guest address (and the bytes after it) are in the export buffer, 0 outside every region.
+uint64_t exportAddress(uint address, uint size)
+{
+    [unroll]
+    for (uint i = 0; i < EXPORT_REGION_COUNT; ++i)
+    {
+        uint4 region = vk::RawBufferLoad<uint4>(g_ExportRegions + i * 16);
+        if (address >= region.x && address + size <= region.y)
+            return g_ExportMemory + region.z + (address - region.x);
+    }
+    return 0;
+}
+
+void memExport(float4 eA, float4 eM0, float4 eM1, float4 eM2, float4 eM3, float4 eM4, uint written)
+{
+    uint4 stream = asuint(eA);
+    // The hardware validates the upper bits of the stream.
+    if (any((stream >> uint4(30, 23, 23, 23)) != uint4(1, 0x96, 0x96, 0x96)))
+        return;
+    uint info = stream.z;
+    uint endian = info & 7;
+    uint format = (info >> 8) & 63;
+    bool isSigned = (info & (1u << 16)) != 0;
+    bool isNorm = (info & (1u << 17)) == 0;
+    bool swapRedBlue = (info & (1u << 19)) != 0;
+    uint index = stream.y & 0x7FFFFF;
+    uint count = stream.w & 0x7FFFFF;
+    // Elements past the end of the stream are not stored.
+    uint remaining = uint(clamp(int(count) - int(index), 0, 5));
+    float4 elements[5] = { eM0, eM1, eM2, eM3, eM4 };
+    [unroll]
+    for (uint i = 0; i < 5; ++i)
+    {
+        if ((written & (1u << i)) == 0 || i >= remaining)
+            continue;
+        uint log2Size;
+        uint4 value = exportSwap128(exportPack(elements[i], format, swapRedBlue, isSigned, isNorm, log2Size), endian);
+        if (log2Size > 4)
+            continue;
+        uint address = (stream.x << 2) + ((index + i) << log2Size);
+        uint64_t target = exportAddress(address, 1u << log2Size);
+        if (target == 0)
+            continue;
+        if (log2Size < 2)
+        {
+            // Part of a dword: the rest is kept.
+            uint shift = (address & (log2Size == 0 ? 3 : 2)) * 8;
+            uint64_t dword = target - (address & 3);
+            uint mask = (log2Size == 0 ? 0xFFu : 0xFFFFu) << shift;
+            vk::RawBufferStore<uint>(dword, (vk::RawBufferLoad<uint>(dword) & ~mask) | ((value.x << shift) & mask));
